{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "portabilityrisk/nmdist_species_contrasts.tsv",
 "title": "nmdist_species_contrasts.tsv",
 "description": "Row schema for nmdist_species_contrasts.tsv. Tab-separated, UTF-8, LF, header row required.",
 "type": "object",
 "properties": {
  "contrast": {
   "type": [
    "string",
    "null"
   ],
   "description": "Registered contrast label."
  },
  "kind": {
   "type": [
    "string",
    "null"
   ],
   "description": "Whether the contrast is primary or secondary/sensitivity."
  },
  "group_a": {
   "type": [
    "string",
    "null"
   ],
   "description": "First group in the contrast."
  },
  "group_b": {
   "type": [
    "string",
    "null"
   ],
   "description": "Second group in the contrast."
  },
  "landmark_bp": {
   "type": [
    "string",
    "null"
   ],
   "description": "Distance landmark in base pairs."
  },
  "estimand": {
   "type": [
    "string",
    "null"
   ],
   "description": "The quantity contrasted, e.g. cumulative detection at a landmark."
  },
  "value_a": {
   "type": [
    "number",
    "null"
   ],
   "description": "Estimate for group_a."
  },
  "value_b": {
   "type": [
    "number",
    "null"
   ],
   "description": "Estimate for group_b."
  },
  "difference": {
   "type": [
    "number",
    "null"
   ],
   "description": "value_a minus value_b."
  },
  "ci_lo": {
   "type": [
    "number",
    "null"
   ],
   "description": "Lower bound, 95 % BioProject cluster bootstrap."
  },
  "ci_hi": {
   "type": [
    "number",
    "null"
   ],
   "description": "Upper bound, 95 % BioProject cluster bootstrap."
  },
  "p_bootstrap": {
   "type": [
    "number",
    "null"
   ],
   "description": "Two-sided bootstrap p-value."
  },
  "p_holm": {
   "type": [
    "number",
    "null"
   ],
   "description": "Holm-adjusted p-value across the registered contrast family."
  }
 },
 "required": [
  "contrast",
  "kind",
  "group_a",
  "group_b",
  "landmark_bp",
  "estimand",
  "value_a",
  "value_b",
  "difference",
  "ci_lo",
  "ci_hi",
  "p_bootstrap",
  "p_holm"
 ],
 "additionalProperties": false
}
